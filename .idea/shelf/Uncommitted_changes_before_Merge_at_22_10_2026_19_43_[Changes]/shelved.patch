ing a bruteforce hacker to the database\nfor i in range(0, 31):\n    if i < 30:\n        login_events.append((2,\"203.0.113.10\",\"FAILED\",(start + timedelta(seconds=i * 2)).strftime(\"%Y-%m-%d %H:%M:%S\")))\n    else:\n        login_events.append((2,\"203.0.113.10\",\"FAILED\",(start + timedelta(seconds=i * 2)).strftime(\"%Y-%m-%d %H:%M:%S\")))\n#inserting data via a list\ncursor.executemany(\"\"\"INSERT INTO login_events (user_id, ip_address, status, timestamp) VALUES (?, ?, ?, ?)\"\"\", login_events)\n#cursor.executemany(\"\"\"INSERT INTO users (user_id, username, role) VALUES (?, ?, ?)\"\"\", users)\n\n#deleting data if i need to\n#cursor.execute(\"\"\"DELETE FROM login_events\"\"\")\n\n#saving the data in the database\nconn.commit()
